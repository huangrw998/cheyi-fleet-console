# ── 依赖 ────────────────────────────────────────────────────────────────────
frontend/node_modules/

# ── 前端构建产物 ────────────────────────────────────────────────────────────
frontend/dist/
frontend/*.tsbuildinfo

# ── 后端构建与嵌入式静态资源 ────────────────────────────────────────────────
backend/cheyi-server
backend/bin/
backend/internal/web/dist/

# ── 数据库与运行时数据 ──────────────────────────────────────────────────────
# 提交项目基准数据库；仅忽略 SQLite 运行时 sidecar 与日志
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.db-journal
backend/data/*.log
*.db-shm
*.db-wal
*.db-journal

# ── 环境变量与密钥 ──────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── 日志、缓存与测试产物 ────────────────────────────────────────────────────
*.log
.cache/
coverage/
test-results/
playwright-report/

# ── 编辑器与系统文件 ────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.tmp

# ── 本地临时文件 ────────────────────────────────────────────────────────────
*.local
